{
  "meta": {
    "title": "指数与基金估值观察台",
    "description": "海外主流指数 + 国内红利低波 / 宽基 ETF 的每日量化观察。评分为规则化计算结果，不构成投资建议。",
    "version": "1.0.6",
    "_version_comment": "三段版本号 x.y.z；每次代码迭代发版末位 +1（如 1.0.0 → 1.0.1），每日定时刷新数据不改动版本号。"
  },
  "weights": {
    "valuation": 0.35,
    "technical": 0.25,
    "crowding": 0.15,
    "risk": 0.25,
    "_comment": "综合得分 = 估值分*valuation + 技术分*technical + (100-拥挤度)*crowding + 风险分*risk；四项权重之和应为 1。拥挤度为量价代理口径（量比/短期涨幅/价格分位），非份额申赎或资金流数据。"
  },
  "thresholds": {
    "strong_buy": 80,
    "buy": 60,
    "hold": 40,
    "sell": 20,
    "_comment": "综合得分(0-100)：>=strong_buy 强烈买入；>=buy 买入；>=hold 观望；>=sell 卖出；其余 强烈卖出。"
  },
  "history_window": {
    "trading_days": 750,
    "_comment": "用于价格分位、均线、动量、波动率与回撤计算的历史交易日条数（约 3 年）。"
  },
  "sources": {
    "hithink_base": "https://fuyao.aicubes.cn/api",
    "timeout_sec": 12,
    "hithink_api_key_env": "HITHINK_API_KEY",
    "_comment": "同花顺 API Key 从环境变量读取，不写入仓库；未配置时国内标的自动回退免费公开源。"
  },
  "categories": {
    "overseas": "海外指数",
    "dividend": "红利低波",
    "broad": "大盘宽基",
    "holding": "我的资产"
  },
